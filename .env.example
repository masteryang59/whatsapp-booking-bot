# Everything is optional. With nothing set, the bot runs with the browser simulator
# at http://localhost:8000 and a local calendar, so you can try it without any accounts.

# Opening hours, services and reminder times live in this file.
BUSINESS_CONFIG=data/business.json
# DB_PATH=data/bookings.db  (docker compose stores it in a volume instead)

# The chat simulator at /. Set to false in production.
SIMULATOR_ENABLED=true

# --- WhatsApp option 1: Meta WhatsApp Cloud API -------------------------------
# Webhook URL to register in the Meta app dashboard: https://<public-host>/webhook/meta
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# App secret, used to check the X-Hub-Signature-256 header on every webhook.
META_APP_SECRET=
# Any string you choose; enter the same one in the dashboard when registering the webhook.
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Approved template for reminders outside the 24-hour window: {{1}} = service, {{2}} = date and time.
META_REMINDER_TEMPLATE=
META_TEMPLATE_LANGUAGE=en

# --- WhatsApp option 2: Twilio -------------------------------------------------
# "When a message comes in" URL in the Twilio console: https://<public-host>/webhook/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio sandbox number, or your own WhatsApp sender.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Approved Content template for reminders: {{1}} = service, {{2}} = date and time.
TWILIO_REMINDER_CONTENT_SID=
# The public base URL Twilio calls (e.g. your ngrok URL). Needed to check signatures behind a proxy.
PUBLIC_BASE_URL=

# --- Google Calendar -----------------------------------------------------------
# Leave empty to use the built-in local calendar.
# Share the calendar with the service account's email ("Make changes to events").
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json

# How often to send due reminders and retry calendar writes.
REMINDER_INTERVAL_SECONDS=60
# A conversation idle for this long starts over.
SESSION_TIMEOUT_MINUTES=30
DECODE_PAYLOAD=enabled
DETECT_LANGUAGE=enabled
DECODE_PAYLOAD=enabled
DETECT_LANGUAGE=enabled